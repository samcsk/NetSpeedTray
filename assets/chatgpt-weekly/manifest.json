{
  "manifest_version": 3,
  "name": "NetSpeedTray weekly limit",
  "version": "1.0.0",
  "description": "Show the weekly limit from your open ChatGPT usage tab on your Windows taskbar.",
  "key": "",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1/*", "https://chatgpt.com/settings/usage*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/settings/usage*"],
    "js": ["weekly.js", "dashboard.js"]
  }],
  "action": {"default_title": "Open ChatGPT weekly usage"}
}
